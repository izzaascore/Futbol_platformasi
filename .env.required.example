# ============================================================
#  Futuro Platform — Railway Deployment: MAJBURIY O'ZGARUVCHILAR
#  Bu faylni .env sifatida to'ldiring. Hech qachon GitHub'ga yubormang!
#
#  MUHIM: Deploy qilishdan OLDIN quyidagilarni Railway → Variables bo'limida
#  o'rnating. Bo'sh qoldirgan qiymatlar ilovani ishga tushirmaydi (RuntimeError).
# ============================================================

# --- JWT Xavfsizlik (MAJBURIY: kamida 32 tasodifiy belgi) ---
# python -c "import secrets; print(secrets.token_hex(32))" bilan yangi kalit oling
SECRET_KEY=bu_yerga_yangi_tasodifiy_kalit_kiriting_kamida_64_belgi

# --- Admin kirish (.env bo'lmasa RuntimeError) ---
# ADMIN_USERNAME: istalgan nom (masalan: futuro_admin)
# ADMIN_PASSKEY: kamida 16 belgi, katta/kichik harf + raqam + belgi
ADMIN_USERNAME=futuro_admin
ADMIN_PASSKEY=Yangi_Kuchli_Parol_Kiriting_16Plus!

# --- Muhit (production bo'lsa HSTS va token tekshiruvi faollashadi) ---
ENVIRONMENT=production

# --- Telegram Bot (MAJBURIY bot ishlashi uchun) ---
# BotFather → /revoke bilan eski tokenni bekor qilib, yangi oling
BOT_TOKEN=yangi_bot_tokenini_bu_yerga
TELEGRAM_BOT_TOKEN=yangi_bot_tokenini_bu_yerga
ADMIN_TELEGRAM_ID=sizning_telegram_id_ingiz

# --- Mini App URL ---
WEBAPP_URL=https://futbol-platformasi-alpha.vercel.app
API_BASE_URL=https://web-production-dc0f4.up.railway.app

# --- Ma'lumotlar bazasi ---
# Railway PostgreSQL ulash satri:
# Masalan: postgresql://postgres:PAROL@containers-us-west-xxx.railway.app:PORT/railway
DATABASE_URL=sqlite:///./data/football.db

# --- OLIB TASHLANG (Railway Variables'dan o'chiring) ---
# MASTER_TOKEN — bu eski backdoor edi, endi ishlatilmaydi

# --- Cloudinary (ixtiyoriy, video yuklash uchun) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
