# Asosiy backend sozlamalari
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MASTER_TOKEN="your_admin_master_token_here"

# Ma'lumotlar bazasi
DATABASE_URL="sqlite:///./football.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Telegram Bot Sozlamalari
BOT_TOKEN="your_telegram_bot_token_here"
ADMIN_TELEGRAM_ID="your_telegram_chat_id_here"
WEBAPP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:8000"

# Cloudinary (Video va Media yuklash)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Obsidian hujjatlar manzili (nisbiy yo'l)
OBSIDIAN_VAULT_PATH="./docs/obsidian_sync"
